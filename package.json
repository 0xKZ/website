{
  "name": "website",
  "version": "1.0.3",
  "description": "Zach's website. This is a public repository because I don't want to pay money to host a static page from a private repository.",
  "author": "Zach Kehs",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('_site',{recursive:true,force:true})\" && npx @11ty/eleventy",
    "check:links": "node scripts/check-links.mjs",
    "check:html": "html-validate _site --ext=html",
    "check:content": "node scripts/check-content.mjs",
    "check": "npm run check:links && npm run check:html && npm run check:content",
    "test": "node scripts/test-post-order.mjs",
    "start": "npx @11ty/eleventy --serve --quiet",
    "debug": "cross-env DEBUG=Eleventy* npx @11ty/eleventy",
    "debugstart": "cross-env DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
    "benchmark": "cross-env DEBUG=Eleventy:Benchmark* npx @11ty/eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@11ty/eleventy-img": "^7.1.1",
    "@11ty/eleventy-navigation": "^1.0.4",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "cross-env": "^10.1.0",
    "eleventy-plugin-footnotes": "^0.11.0",
    "html-validate": "^11.18.0",
    "luxon": "^3.6.1",
    "prismjs": "^1.30.0",
    "zod": "^4.6.7",
    "zod-validation-error": "^5.0.0"
  },
  "dependencies": {
    "@zachleat/heading-anchors": "^1.0.5",
    "markdown-it": "^15.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
