{
  "name": "website",
  "version": "1.0.3",
  "description": "Zach's website. This is a public repository because I don't want to pay money to host a static page from a private repository.",
  "author": "Zach Kehs",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "npx @11ty/eleventy",
    "check:links": "node scripts/check-links.mjs",
    "check:html": "html-validate _site --ext=html",
    "check:content": "node scripts/check-content.mjs",
    "check": "npm run check:links && npm run check:html && npm run check:content",
    "build-nocolor": "cross-env NODE_DISABLE_COLORS=1 npx @11ty/eleventy",
    "build-ghpages": "npx @11ty/eleventy",
    "start": "npx @11ty/eleventy --serve --quiet",
    "start-ghpages": "npx @11ty/eleventy --serve --quiet",
    "debug": "cross-env DEBUG=Eleventy* npx @11ty/eleventy",
    "debugstart": "cross-env DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
    "benchmark": "cross-env DEBUG=Eleventy:Benchmark* npx @11ty/eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-navigation": "^1.0.4",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "cross-env": "^7.0.3",
    "eleventy-plugin-footnotes": "^0.11.0",
    "html-validate": "^11.12.0",
    "luxon": "^3.6.1",
    "prismjs": "^1.30.0",
    "zod": "^3.25.67",
    "zod-validation-error": "^3.5.2"
  },
  "dependencies": {
    "@zachleat/heading-anchors": "^1.0.5",
    "markdown-it": "^14.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
