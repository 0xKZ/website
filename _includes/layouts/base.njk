<!doctype html>
<html lang="{{ metadata.language }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{{ title or metadata.title }}</title>
		<meta name="description" content="{{ description or metadata.description }}">

		{#- Canonical URL + Open Graph / Twitter Card tags.
		    Skipped on the 404 page: a canonical there would claim the 404 is a
		    duplicate of a real page, which is wrong. #}
		{%- if page.url != '/404.html' %}
		{%- set canonicalUrl = page.url | htmlBaseUrl(metadata.url) %}
		{%- set isPost = layout == 'layouts/post.njk' %}
		<link rel="canonical" href="{{ canonicalUrl }}">
		<meta property="og:site_name" content="{{ metadata.title }}">
		<meta property="og:type" content="{{ 'article' if isPost else 'website' }}">
		<meta property="og:title" content="{{ title or metadata.title }}">
		<meta property="og:description" content="{{ description or metadata.description }}">
		<meta property="og:url" content="{{ canonicalUrl }}">
		{#- TODO(og-image): the site has no share image yet. Add a 1200x630 image
		    (e.g. public/img/og-image.png) and emit `<meta property="og:image">`
		    here (honoring an optional `og_image:` front-matter key per page), then
		    switch twitter:card to `summary_large_image`. #}
		<meta name="twitter:card" content="summary">
		{%- if isPost %}
		<meta property="article:published_time" content="{{ page.date | dateToRfc3339 }}">
		<meta property="article:author" content="{{ metadata.author.name }}">
		{%- endif %}
		{%- endif %}

		<link rel="alternate" href="{{ '/feed/feed.xml' | url }}" type="application/atom+xml" title="{{ metadata.title }}">

		{#- Preconnect to the origins we load third-party scripts from (SimpleAnalytics in
		    this layout's <body>, EmailOctopus via mailing_list_signup.njk) so their TLS
		    handshakes start early. Unused preconnects are dropped by browsers. #}
		<link rel="preconnect" href="https://scripts.simpleanalyticscdn.com">
		<link rel="preconnect" href="https://eocampaign1.com">

		{#- Uncomment this if you’d like folks to know that you used Eleventy to build your site!  #}
		{#- <meta name="generator" content="{{ eleventy.generator }}"> #}

		{#-
		Plain-text bundles are provided via the `eleventy-plugin-bundle` plugin:
		1. CSS:
			* Add to a per-page bundle using `{% css %}{% endcss %}`
			* Retrieve bundle content using `{% getBundle "css" %}` or `{% getBundleFileUrl "css" %}`
		2. Or for JavaScript:
			* Add to a per-page bundle using `{% js %}{% endjs %}`
			* Retrieve via `{% getBundle "js" %}` or `{% getBundleFileUrl "js" %}`
		3. Learn more: https://github.com/11ty/eleventy-plugin-bundle
		#}

		{#- Add CSS to the bundle #}
		<style>/* This is an arbitrary CSS string added to the bundle */</style>

		{#- Add the contents of a file to the bundle #}
		<style>{% include "css/index.css" %}</style>

		{#- Or you can add from node_modules #}
		{# <style>{% include "node_modules/something.css" %}</style> #}

		{#- Render the CSS bundle using inlined CSS (for the fastest site performance in production) #}
		<style>{% getBundle "css" %}</style>

		{#- Renders the CSS bundle using a separate file, if you can't set CSP directive style-src: 'unsafe-inline' #}
		{#- <link rel="stylesheet" href="{% getBundleFileUrl "css" %}"> #}

		{#- Add the heading-anchors web component to the JavaScript bundle #}
		<script type="module">{% include "node_modules/@zachleat/heading-anchors/heading-anchors.js" %}</script>
	</head>
	<body>
		<a href="#main" id="skip-link" class="visually-hidden">Skip to main content</a>

		<header>
			<a href="/" class="home-link">{{ metadata.title }}</a>

			{#- Read more about `eleventy-navigation` at https://www.11ty.dev/docs/plugins/navigation/ #}
			<nav>
				<h2 class="visually-hidden">Top level navigation menu</h2>
				<ul class="nav">
				{%- for entry in collections.all | eleventyNavigation %}
					<li class="nav-item"><a href="{{ entry.url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a></li>
				{%- endfor %}
				</ul>
			</nav>
		</header>

		<main id="main">
			<heading-anchors>
				{{ content | safe }}
			</heading-anchors>
		</main>

		<!--<footer>
			<p>
				<em>Blah blah blah, this is a footer if you want one.</em>
			</p>
		</footer>-->

		<!-- This page `{{ page.url }}` was built on {% currentBuildDate %} -->
		<script type="module" src="{% getBundleFileUrl "js" %}"></script>

		<!-- SimpleAnalytics integration -->
		<script async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
	</body>
</html>
