<!doctype html>
<html lang="{{ metadata.language }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		{#- Mark <html> with a `js` class so CSS can gate enhancements that
		    need JavaScript (e.g. hiding pull-quote backlinks until the quote
		    is clicked). eleventy:ignore keeps it inline instead of moving it
		    to the per-page bundle, so it runs before first paint. #}
		<script eleventy:ignore>document.documentElement.classList.add("js")</script>
		{#- Apply a saved light/dark override (persisted by the theme toggle,
		    see below) before first paint so there's no flash of the wrong
		    theme. No saved value means "follow the system setting" — the
		    same invariant the toggle's CSS and JS rely on.
		    eleventy:ignore keeps it inline instead of moving it to the
		    per-page bundle, so it runs before first paint. #}
		<script eleventy:ignore>
			(function () {
				try {
					var theme = localStorage.getItem("zk-theme");
					if (theme === "light" || theme === "dark") {
						document.documentElement.dataset.theme = theme;
					}
				} catch {
					/* no localStorage access: follow the system setting */
				}
			})();
		</script>
		<title>{{ title or metadata.title }}</title>
		<meta name="description" content="{{ description or metadata.description }}">

		{#- Canonical URL + Open Graph / Twitter Card tags.
		    Skipped on the 404 page: a canonical there would claim the 404 is a
		    duplicate of a real page, which is wrong. #}
		{%- if page.url != '/404.html' %}
		{%- set canonicalUrl = page.url | htmlBaseUrl(metadata.url) %}
		{%- set isPost = layout == 'layouts/post.njk' %}
		<link rel="canonical" href="{{ canonicalUrl }}">
		<meta property="og:site_name" content="{{ metadata.title }}">
		<meta property="og:type" content="{{ 'article' if isPost else 'website' }}">
		<meta property="og:title" content="{{ title or metadata.title }}">
		<meta property="og:description" content="{{ description or metadata.description }}">
		<meta property="og:url" content="{{ canonicalUrl }}">
		{#- TODO(og-image): the site has no share image yet. Add a 1200x630 image
		    (e.g. public/img/og-image.png) and emit `<meta property="og:image">`
		    here (honoring an optional `og_image:` front-matter key per page), then
		    switch twitter:card to `summary_large_image`. #}
		<meta name="twitter:card" content="summary">
		{%- if isPost %}
		<meta property="article:published_time" content="{{ page.date | dateToRfc3339 }}">
		<meta property="article:author" content="{{ metadata.author.name }}">
		{%- endif %}
		{%- endif %}

		<link rel="alternate" href="{{ '/feed/feed.xml' | url }}" type="application/atom+xml" title="{{ metadata.title }}">

		{#- Preconnect to the origins we load third-party scripts from (SimpleAnalytics in
		    this layout's <body>, EmailOctopus via mailing_list_signup.njk) so their TLS
		    handshakes start early. Unused preconnects are dropped by browsers. #}
		<link rel="preconnect" href="https://scripts.simpleanalyticscdn.com">
		<link rel="preconnect" href="https://eocampaign1.com">

		{#- Add the contents of a file to the bundle #}
		<style>{% include "css/index.css" %}</style>

		{#- Render the CSS bundle using inlined CSS (for the fastest site performance in production) #}
		<style>{% getBundle "css" %}</style>

		{#- Add the heading-anchors web component to the JavaScript bundle #}
		<script type="module">{% include "node_modules/@zachleat/heading-anchors/heading-anchors.js" %}</script>

		{#- Reveal pull-quote backlinks only after the pull quote has actually
		    been clicked (the transform that adds them: _config/pullQuotes.js,
		    the display rules: css/index.css) #}
		<script type="module">
			document.addEventListener("click", (event) => {
				const link = event.target.closest?.(".pull-quote a[href^='#']");
				if (!link) return;
				const id = decodeURIComponent(link.hash.slice(1));
				document.getElementById(id)?.classList.add("pull-quote-visited");
			});
		</script>

		{#- Light/dark toggle: flip the `data-theme` override on <html> and
		    persist the choice. "No data-theme = follow the system" is an
		    invariant shared with the pre-paint script above and the icon
		    rules in css/index.css — change all three together. aria-pressed
		    always reflects the effective theme, including a system setting
		    that changes while the page is open. #}
		<script type="module">
			(function () {
				const button = document.querySelector(".theme-toggle");
				if (!button) return;

				const root = document.documentElement;
				const STORAGE_KEY = "zk-theme";
				const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");
				const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
				// The system setting; an explicit override (data-theme) wins over it
				const systemTheme = () => (prefersDark.matches ? "dark" : "light");
				const effectiveTheme = () => root.dataset.theme || systemTheme();
				// A value pins the theme; null clears the override (follow the system)
				const setTheme = (theme) => {
					if (theme) root.dataset.theme = theme;
					else delete root.dataset.theme;
					try {
						if (theme) localStorage.setItem(STORAGE_KEY, theme);
						else localStorage.removeItem(STORAGE_KEY);
					} catch {
						/* no localStorage access: the choice just won't persist */
					}
				};

				// No static aria-pressed in the markup: a hardcoded default would
				// misstate the mode until this runs
				const syncPressed = () =>
					button.setAttribute("aria-pressed", String(effectiveTheme() === "dark"));
				syncPressed();

				// If the system setting flips while the page is open, the CSS flips the
				// colors and icon by itself — but only re-sync aria-pressed when the
				// site is actually following the system (an override pins the state)
				prefersDark.addEventListener("change", () => {
					if (!root.dataset.theme) syncPressed();
				});

				button.addEventListener("click", () => {
					const target = effectiveTheme() === "dark" ? "light" : "dark";
					const apply = () => {
						// Toggling back to the current system setting clears the
						// override, so the site keeps following the system instead
						// of staying pinned
						setTheme(target === systemTheme() ? null : target);
						syncPressed();
					};
					// Crossfade the swap with the View Transition API (the same one
					// the site uses for navigation, see css/index.css), except while
					// another transition is in progress (a second startViewTransition()
					// call would throw InvalidStateError; navigation transitions are
					// the common case) and under prefers-reduced-motion (an explicit
					// call isn't guaranteed to be suppressed by the browser, unlike
					// automatic navigation transitions). The callback runs
					// synchronously inside startViewTransition(), so `target` above
					// is always up to date — no bookkeeping needed for fast clicks.
					const canCrossfade = "startViewTransition" in document &&
						!document.viewTransition &&
						!prefersReducedMotion.matches;
					if (canCrossfade) {
						document.startViewTransition(apply);
					} else {
						apply();
					}
				});
			})();
		</script>
	</head>
	<body>
		<a href="#main" id="skip-link" class="visually-hidden">Skip to main content</a>

		<header>
			<a href="/" class="home-link">{{ metadata.title }}</a>

			{#- Read more about `eleventy-navigation` at https://www.11ty.dev/docs/plugins/navigation/ #}
			<nav>
				<h2 class="visually-hidden">Top level navigation menu</h2>
				<ul class="nav">
				{%- for entry in collections.all | eleventyNavigation %}
					<li class="nav-item"><a href="{{ entry.url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a></li>
				{%- endfor %}
				</ul>
			</nav>

			{#- Light/dark mode toggle (styles + icon switching: css/index.css,
			    pre-paint restore of the saved choice + click handler: scripts
			    in <head> above). The label names the control rather than a
			    mode, so it stays true in both themes; the state lives in
			    aria-pressed, which the handler sets (no static default, which
			    would misstate the mode until the bundle runs). #}
			<button type="button" class="theme-toggle" aria-label="Toggle dark mode">
				<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
				<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="5"></circle>
					<line x1="12" y1="1" x2="12" y2="3"></line>
					<line x1="12" y1="21" x2="12" y2="23"></line>
					<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
					<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
					<line x1="1" y1="12" x2="3" y2="12"></line>
					<line x1="21" y1="12" x2="23" y2="12"></line>
					<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
					<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
				</svg>
			</button>
		</header>

		<main id="main">
			<heading-anchors>
				{{ content | safe }}
			</heading-anchors>
		</main>

		<footer>
			{#- Simple Analytics badge (text link variant; build-your-own page:
			    https://www.simpleanalytics.com/badges). The <style> joins the
			    per-page CSS bundle like all inline styles in this template.
			    Keep the link's UTM parameters exactly as-is - Simple Analytics
			    uses them to detect the badge (see /badges.md). #}

			<style>
				a.sa-credit, a.sa-credit:visited, a.sa-credit:hover, a.sa-credit:active {
					all: unset !important; display: block !important; cursor: pointer !important;
					line-height: 1.6 !important;
					/* Quieter than the body text; `!important` because `all: unset`
					   above resets opacity and can't be overridden from the site CSS */
					opacity: 0.7 !important;
				}
				/* Back to full strength on hover/focus to signal the badge is a link */
				a.sa-credit:hover,
				a.sa-credit:focus-visible {
					opacity: 1 !important;
				}
				a.sa-credit:focus-visible {
					outline: 2px solid currentColor !important; outline-offset: 4px !important;
				}
				a.sa-credit > span { all: unset !important; }
				a.sa-credit > .sa-credit__byline { white-space: nowrap !important; }
				a.sa-credit svg {
					all: unset !important; display: inline-block !important;
					height: 0.914em !important; vertical-align: -0.2em !important;
					fill: currentColor !important;
				}
				@supports (height: 1cap) {
					a.sa-credit svg { height: 1.305714cap !important; vertical-align: -0.285714cap !important; }
				}
			</style>
			<a class="sa-credit" href="https://www.simpleanalytics.com?utm_source=zachkehs.com&utm_content=badge" referrerpolicy="origin" target="_blank">
				<span class="sa-credit__caption">100% privacy-first analytics</span>
				<span class="sa-credit__byline">by <svg viewBox="0 -714 8871 914" xmlns="http://www.w3.org/2000/svg" role="img"><title>Simple Analytics</title><g transform="translate(0 -700) scale(.7)"><path d="M54 538h154v462H54zm369-276h154v738H423zM792 0h154v1000H792z"/></g><path transform="translate(900 0)" d="M311 14Q232 14 171.0 -14.0Q110 -42 75.5 -96.5Q41 -151 41 -229V-254H148V-229Q148 -154 192.5 -117.5Q237 -81 311 -81Q385 -81 423.5 -112.5Q462 -144 462 -194Q462 -244 422.5 -266.5Q383 -289 314 -305L277 -314Q209 -329 160.0 -353.0Q111 -377 84.0 -416.0Q57 -455 57 -516Q57 -609 123.5 -661.5Q190 -714 299 -714Q372 -714 429.5 -689.0Q487 -664 520.0 -615.0Q553 -566 553 -492V-456H446V-492Q446 -560 405.5 -589.5Q365 -619 299 -619Q234 -619 199.0 -592.5Q164 -566 164 -519Q164 -471 198.5 -448.0Q233 -425 300 -410L337 -401Q404 -386 456.5 -362.5Q509 -339 539.0 -299.0Q569 -259 569 -196Q569 -133 537.5 -86.0Q506 -39 448.0 -12.5Q390 14 311 14ZM686 0V-493H789V0ZM738 -560Q708 -560 687.5 -579.5Q667 -599 667 -630Q667 -661 687.5 -680.5Q708 -700 738 -700Q768 -700 788.5 -680.5Q809 -661 809 -630Q809 -599 788.5 -579.5Q768 -560 738 -560ZM942 0V-493H1043V-435H1059Q1073 -461 1103.5 -481.0Q1134 -501 1188 -501Q1243 -501 1276.5 -478.0Q1310 -455 1327 -421H1343Q1359 -455 1392.0 -478.0Q1425 -501 1485 -501Q1556 -501 1603.5 -456.5Q1651 -412 1651 -328V0H1548V-321Q1548 -365 1523.5 -389.5Q1499 -414 1454 -414Q1406 -414 1377.0 -383.0Q1348 -352 1348 -294V0H1245V-321Q1245 -365 1220.5 -389.5Q1196 -414 1151 -414Q1103 -414 1074.0 -383.0Q1045 -352 1045 -294V0ZM1799 200V-493H1900V-422H1916Q1935 -455 1973.5 -481.0Q2012 -507 2084 -507Q2145 -507 2197.0 -477.0Q2249 -447 2280.5 -390.0Q2312 -333 2312 -254V-239Q2312 -159 2280.5 -102.5Q2249 -46 2197.5 -16.0Q2146 14 2084 14Q2012 14 1973.5 -11.5Q1935 -37 1918 -67H1902V200ZM2054 -76Q2121 -76 2164.5 -119.0Q2208 -162 2208 -242V-251Q2208 -330 2164.5 -373.0Q2121 -416 2054 -416Q1988 -416 1944.5 -373.0Q1901 -330 1901 -251V-242Q1901 -162 1944.0 -119.0Q1987 -76 2054 -76ZM2440 0V-700H2543V0ZM2922 